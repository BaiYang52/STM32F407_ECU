# EditorConfig helps maintain consistent coding styles

root = true

# C files
[*.{c,h}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# CMake
[CMakeLists.txt]
indent_size = 2

# Shell scripts
[*.{sh,bash}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false